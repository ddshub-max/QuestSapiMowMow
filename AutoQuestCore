local isFarming = false
local speedTruckInput = G2L["19"]
local playBtn = G2L["e"]

local function eksekusiKlik(tombol)
    if not tombol then return end
    if firesignal then firesignal(tombol.Activated); firesignal(tombol.MouseButton1Click)
    elseif getconnections then
        for _, conn in pairs(getconnections(tombol.Activated)) do conn:Fire() end
        for _, conn in pairs(getconnections(tombol.MouseButton1Click)) do conn:Fire() end
    end
end

local function cariSapi(daftarAbaikan)
    daftarAbaikan = daftarAbaikan or {}
    local sapiCadangan = nil

    for _, objek in ipairs(workspace:GetChildren()) do
        if string.match(objek.Name, "^Cow_") then
            local sudahDikerjakan = false
            for _, sapiLama in ipairs(daftarAbaikan) do
                if objek == sapiLama then sudahDikerjakan = true; break end
            end

            if not sudahDikerjakan then
                local baseScale = objek:GetAttribute("BaseScale")
                local mutations = objek:GetAttribute("Mutations")
                
                local isGiant = (type(baseScale) == "number" and baseScale > 0.38)
                local isMutant = (mutations ~= nil and mutations ~= "" and mutations ~= "None")

                if isGiant or isMutant then
                    print("  [⭐] Sapi Spesial Ditemukan! (Giant/Mutant) -> " .. objek.Name)
                    return objek 
                else
                    if not sapiCadangan then sapiCadangan = objek end
                end
            end
        end
    end
    
    if sapiCadangan then print("  [Normal] Ambil sapi biasa -> " .. sapiCadangan.Name) end
    return sapiCadangan
end

local function selesaikanTugasSapiAkurat()
    local minigameGui = playerGui:WaitForChild("QurbanMinigameGui", 5)
    if not minigameGui then return false end
    
    local main = minigameGui:WaitForChild("Main")
    local mobileButtons = minigameGui:WaitForChild("MobileButtons")
    local instructionLbl = main:WaitForChild("Instruction")
    local counterLbl = main:WaitForChild("MashCounter")
    
    local ronde, maxRonde = 1, 12 
    while minigameGui.Enabled and ronde <= maxRonde and isFarming do
        local tombolPertama, waktuTunggu = nil, tick()
        repeat
            for _, child in ipairs(mobileButtons:GetChildren()) do
                if string.match(child.Name, "^BtnKey_") then tombolPertama = child break end
            end
            task.wait(0.1)
        until tombolPertama or (tick() - waktuTunggu > 10) or not minigameGui.Enabled or not isFarming
        
        if not minigameGui.Enabled or not isFarming then break end
        if not tombolPertama then return false end

        local instText, countText = instructionLbl.Text, counterLbl.Text
        local tipeSoal, urutanTombol, targetClicks = "", {}, 1

        if string.find(instText, ">") or string.find(instText, "→") then
            tipeSoal = "SEQUENCE"
            for huruf in string.gmatch(instText, "%u") do table.insert(urutanTombol, huruf) end
        elseif string.find(string.lower(instText), "get ready") then
            tipeSoal = "READY"
            local huruf = string.match(instText, "%[(%u)%]") or string.match(string.upper(string.gsub(string.lower(instText), "get ready", "")), "%u")
            if huruf then table.insert(urutanTombol, huruf) end
        else
            tipeSoal = "TAP"
            local huruf = string.match(instText, "%[(%u)%]") or string.match(string.upper(string.gsub(string.lower(instText), "tap", "")), "%u")
            if huruf then table.insert(urutanTombol, huruf) end
            local angkaTarget = string.match(countText, "/%s*(%d+)")
            if angkaTarget then targetClicks = tonumber(angkaTarget) else targetClicks = tonumber(string.match(countText, "%d+")) or 1 end
        end

        if tipeSoal == "SEQUENCE" then
            for _, huruf in ipairs(urutanTombol) do
                local btnTarget = mobileButtons:WaitForChild("BtnKey_" .. huruf, 3)
                if btnTarget then eksekusiKlik(btnTarget); task.wait(0.3) end
            end
        else
            local hurufTarget = urutanTombol[1]
            if hurufTarget then
                local btnTarget = mobileButtons:FindFirstChild("BtnKey_" .. hurufTarget)
                if btnTarget then
                    for i = 1, targetClicks do
                        if not btnTarget.Parent or not minigameGui.Enabled or not isFarming then break end
                        eksekusiKlik(btnTarget); task.wait(0.1) 
                    end
                end
            end
        end

        repeat
            local masihAda = false
            for _, child in ipairs(mobileButtons:GetChildren()) do
                if string.match(child.Name, "^BtnKey_") then masihAda = true break end
            end
            task.wait(0.1)
        until not masihAda or not minigameGui.Enabled or not isFarming
        
        task.wait(0.5); ronde = ronde + 1
    end
    return true
end

local function jalankanAutoFarmSapi()
    jalankanAntiTabrakSapi()
    local character = player.Character or player.CharacterAdded:Wait()
    local hrp = character:WaitForChild("HumanoidRootPart")
    
    local targetNPC = workspace:WaitForChild("Event"):WaitForChild("NPC"):FindFirstChild("DA0ZA")
    if targetNPC then
        hrp.CFrame = targetNPC:GetPivot() * CFrame.new(0, 0, 3)
        task.wait(0.5)
        local prompt = targetNPC:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then
            fireproximityprompt(prompt); task.wait(1) 
            replicatedStorage:WaitForChild("EventAsset"):WaitForChild("QurbanRemotes"):WaitForChild("DialogResponse"):FireServer({ dialogId = "QurbanIntro", response = "accept" })
        end
    end
    
    local sapiSelesai = {} 
    for urutan = 1, 4 do
        if not isFarming then break end
        if urutan == 1 then task.wait(3) end
        
        local sapiTarget = cariSapi(sapiSelesai)
        local waktuTunggu = tick()
        while not sapiTarget and (tick() - waktuTunggu < 20) and isFarming do
            task.wait(1); sapiTarget = cariSapi(sapiSelesai)
        end
        
        if sapiTarget then
            hrp.CFrame = sapiTarget:GetPivot() * CFrame.new(0, 0, 3); task.wait(0.5)
            local promptSapi = sapiTarget:FindFirstChildWhichIsA("ProximityPrompt", true)
            if promptSapi then
                fireproximityprompt(promptSapi); task.wait(1)
                if selesaikanTugasSapiAkurat() then table.insert(sapiSelesai, sapiTarget) end
            end
        else break end
    end
    return true
end

-- ==========================================
-- 5. TRUCK FLIGHT SYSTEM
-- ==========================================
local cacheFisikaTruk = {}
local function aturFisikaTruk(truk, modeNormal)
    for _, part in ipairs(truk:GetDescendants()) do
        if part:IsA("BasePart") then
            if not modeNormal then
                if cacheFisikaTruk[part] == nil then cacheFisikaTruk[part] = { Collide = part.CanCollide, Anchor = part.Anchored } end
                part.CanCollide = false; part.Anchored = true
            else
                if cacheFisikaTruk[part] ~= nil then part.CanCollide = cacheFisikaTruk[part].Collide; part.Anchored = cacheFisikaTruk[part].Anchor
                else part.CanCollide = true; part.Anchored = false end
                part.AssemblyLinearVelocity = Vector3.new(0, 0, 0); part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end
        end
    end
end

local function jalankanTrukModeAman()
    noclipSapiAktif = false
    local trukTarget, tujuan = nil, workspace:FindFirstChild("DestinationBeacon")
    for _, objek in ipairs(workspace:FindFirstChild("Vehicles"):GetChildren()) do
        if string.match(objek.Name, "^QurbanTruck_") then trukTarget = objek break end
    end
    
    if trukTarget and tujuan then
        local KECEPATAN_CEPAT = tonumber(speedTruckInput.Text) or 100 
        local KECEPATAN_PELAN = 50  
        
        local startCFrame, targetCFrame_Awal = trukTarget:GetPivot(), tujuan:GetPivot()
        
        local rayParams = RaycastParams.new()
        rayParams.FilterDescendantsInstances = {trukTarget} 
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        
        local hitResult = workspace:Raycast(targetCFrame_Awal.Position, Vector3.new(0, -2000, 0), rayParams)
        local posisiTanahCFrame = hitResult and (CFrame.new(hitResult.Position) * targetCFrame_Awal.Rotation) or targetCFrame_Awal
        
        local endCFrame = posisiTanahCFrame + Vector3.new(0, 3.5, 0) 
        local tweenValue = Instance.new("CFrameValue")
        tweenValue.Value = startCFrame
        local koneksi = tweenValue.Changed:Connect(function(c) trukTarget:PivotTo(c) end)
        
        local function terbangKeTitik(tCFrame, kec)
            if not isFarming then return end
            local wkt = math.max((tweenValue.Value.Position - tCFrame.Position).Magnitude / kec, 0.1)
            local twn = TweenService:Create(tweenValue, TweenInfo.new(wkt, Enum.EasingStyle.Linear), {Value = tCFrame})
            twn:Play(); twn.Completed:Wait() 
        end
        
        aturFisikaTruk(trukTarget, false)
        terbangKeTitik(startCFrame + Vector3.new(0, 400, 0), KECEPATAN_CEPAT)
        terbangKeTitik(endCFrame + Vector3.new(0, 400, 0), KECEPATAN_CEPAT) 
        terbangKeTitik(endCFrame, KECEPATAN_PELAN) 
        
        koneksi:Disconnect(); tweenValue:Destroy(); task.wait(0.5)
        local brakeEvent = trukTarget:FindFirstChild("Brakeoverheat")
        if brakeEvent then brakeEvent:FireServer("SoundUpdate", 0, "Sound1") end
        aturFisikaTruk(trukTarget, true)
    end
end


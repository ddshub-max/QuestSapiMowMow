button.MouseButton1Click:Connect(function()
    mainFrame.Visible = not mainFrame.Visible
end)

local inputPoin, estimasiLabel, endFarmTotal = G2L["12"], G2L["1d"], G2L["15"]
local PoinPerSiklus, DetikPerSiklus, CurrentPoint = 100, 80, 0 

inputPoin:GetPropertyChangedSignal("Text"):Connect(function()
    local targetPoin = tonumber(inputPoin.Text) or 0
    endFarmTotal.Text = tostring(CurrentPoint + targetPoin)
    
    local jumlahSiklus = math.ceil(targetPoin / PoinPerSiklus)
    local totalDetik = jumlahSiklus * DetikPerSiklus
    
    local jam = math.floor(totalDetik / 3600)
    local menit = math.floor((totalDetik % 3600) / 60)
    estimasiLabel.Text = string.format("%02d:%02d", jam, menit)
end)


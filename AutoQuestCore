local function StartAutoFarmLoop()
    while isFarming do
        local successFarm, errFarm = pcall(jalankanAutoFarmSapi)
        if not successFarm then warn("Error Sapi: " .. tostring(errFarm)) end
        task.wait(2) 
        if not isFarming then break end
        
        local successTruk, errTruk = pcall(jalankanTrukModeAman)
        if not successTruk then warn("Error Truk: " .. tostring(errTruk)) end
        task.wait(7)
    end
end

PlayBtn.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    if isFarming then
        PlayBtn.Text = "Stop Farm"
        PlayBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
        
        startingPoints = getPointsNum()
        StartPointLabel.Text = tostring(startingPoints)
        
        task.spawn(StartAutoFarmLoop)
    else
        PlayBtn.Text = "Start Farm"
        PlayBtn.BackgroundColor3 = Color3.fromRGB(47, 0, 117)
        noclipSapiAktif = false
    end
end)

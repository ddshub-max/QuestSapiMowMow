local function getPointsNum()
    local eventShop = playerGui:FindFirstChild("EVENT SHOP")
    if eventShop then
        local valueLabel = eventShop:FindFirstChild("Shop", true)
        if valueLabel then
            local pointsText = valueLabel.Parent:FindFirstChild("PointsPill", true)
            if pointsText and pointsText:FindFirstChild("Value") then
                -- Menghapus semua karakter kecuali angka (mengatasi format "3.000 Points")
                local rawText = pointsText.Value.Text
                local numStr = string.gsub(rawText, "%D", "")
                return tonumber(numStr) or 0
            end
        end
    end
    return 0
end

